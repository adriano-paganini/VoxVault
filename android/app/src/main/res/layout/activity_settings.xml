<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">
        <ImageButton
            android:id="@+id/backButton"
            style="@style/VoxVault.IconButton"
            android:src="?attr/homeAsUpIndicator"
            android:contentDescription="@string/back" />
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/voxvault_logo" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="8dp"
            android:text="@string/settings_title"
            android:textAppearance="@style/TextAppearance.Material3.TitleLarge" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <TextView
                style="@style/VoxVault.SettingsHeading"
                android:text="@string/connection_title" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/backendUrlLayout"
                style="@style/VoxVault.SettingsInput"
                android:hint="@string/backend_url">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/backendUrlEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/backendPortLayout"
                style="@style/VoxVault.SettingsInput"
                android:hint="@string/backend_port">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/backendPortEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="5" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/VoxVault.SettingsHeading"
                android:text="@string/recording_settings_title" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/maxSilenceLayout"
                style="@style/VoxVault.SettingsInput"
                android:hint="@string/max_silence">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/maxSilenceEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/preBufferLayout"
                style="@style/VoxVault.SettingsInput"
                android:hint="@string/pre_buffer">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/preBufferEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/VoxVault.SettingsHeading"
                android:text="@string/encryption_title" />
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/encryptionPublicKeyLayout"
                style="@style/VoxVault.SettingsInput"
                android:hint="@string/encryption_public_key">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/encryptionPublicKeyEdit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textNoSuggestions|textMultiLine"
                    android:fontFamily="monospace"
                    android:textSize="14sp"
                    android:minLines="2"
                    android:gravity="top" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/saveButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:minHeight="56dp"
        android:text="@string/save"
        app:icon="@android:drawable/ic_menu_save"
        app:iconGravity="textStart" />
</LinearLayout>
