<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.VoxVault" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/vault_primary</item>
        <item name="colorOnPrimary">@color/vault_on_primary</item>
        <item name="colorSecondary">@color/vault_secondary</item>
        <item name="colorSecondaryContainer">@color/vault_primary_container</item>
        <item name="colorOnSecondaryContainer">@color/vault_on_surface</item>
        <item name="colorPrimaryContainer">@color/vault_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/vault_on_surface</item>
        <item name="android:windowBackground">@color/vault_surface</item>
        <item name="colorSurface">@color/vault_surface</item>
        <item name="colorOnSurface">@color/vault_on_surface</item>
        <item name="colorOutline">@color/vault_outline</item>
        <item name="shapeAppearanceSmallComponent">@style/VoxVault.Shape</item>
        <item name="shapeAppearanceMediumComponent">@style/VoxVault.Shape</item>
    </style>

    <style name="Theme.VoxVault" parent="Base.Theme.VoxVault" />
    <style name="VoxVault.Shape" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">6dp</item>
    </style>
</resources>
