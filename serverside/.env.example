# Backend listen port and Docker host port.
VOXVAULT_PORT=6100
# Absolute host directory for the server-privatekey.key encryption key.
VOXVAULT_KEY_DIR_HOST=/etc/voxvault
# Address suggested during Android setup; does not bind the server.
VOXVAULT_PUBLIC_URL=http://your-server-address:6100

# Whisper model size/name to download and use for transcription.
WHISPERX_MODEL=large-v3
# Inference device; only cpu is currently supported.
WHISPERX_DEVICE=cpu
# CPU inference precision; int8 uses less memory.
WHISPERX_COMPUTE_TYPE=int8
# Audio segments transcribed together; larger batches use more memory.
WHISPERX_BATCH_SIZE=8
# CPU threads used when loading the Whisper model.
WHISPERX_CPU_THREADS=4
# Confidence threshold for rejecting unexpected language detections.
WHISPERX_LANGUAGE_MIN_CONFIDENCE=0.7
# Maximum seconds of speech sampled for language detection.
WHISPERX_LANGUAGE_SAMPLE_SECONDS=30
# Seconds of inactivity before loaded models are released.
VOXVAULT_MODEL_IDLE_SECONDS=5
# Writable directory for temporary queued audio files.
VOXVAULT_PROCESSING_DIR=.

# PostgreSQL hostname; use postgres for Docker Compose.
POSTGRES_HOST=postgres
# PostgreSQL database created on first initialization.
POSTGRES_DB=voxvault
# PostgreSQL account created on first initialization.
POSTGRES_USER=voxvault
# Password for that PostgreSQL account; change before first startup.
POSTGRES_PASSWORD=voxvault
# Maximum startup attempts while waiting for PostgreSQL.
DATABASE_INIT_RETRIES=30
# Seconds between database startup attempts.
DATABASE_INIT_RETRY_DELAY_SECONDS=2

# Hugging Face read token for speaker diarization; empty disables it.
HUGGINGFACE_TOKEN=
